APP_NAME=Microgames
APP_ENV=production
APP_KEY=base64:GENERATE_A_SECURE_KEY
APP_DEBUG=false
# APP_URL and FRONTEND_URL are optional on Vercel. Set both to the same
# https:// URL only when you attach a custom domain.

LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=array
QUEUE_CONNECTION=sync

DB_CONNECTION=mongodb
DB_DSN=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_DATABASE=microgames

# Cookie sessions keep the container stateless. The cart only stores game IDs.
SESSION_DRIVER=cookie
# Leave SESSION_DOMAIN unset unless you need to share cookies across subdomains.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# SANCTUM_STATEFUL_DOMAINS and CORS_ALLOWED_ORIGINS are inferred automatically.

STRIPE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET=sk_test_REPLACE_ME

# Persistent user uploads (AWS S3 or an S3-compatible provider).
UPLOADS_DRIVER=s3
UPLOADS_VISIBILITY=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
# AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=https://PUBLIC_BUCKET_DOMAIN
AWS_USE_PATH_STYLE_ENDPOINT=false
