# syntax=docker/dockerfile:1

FROM node:22 AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:22 AS laravel-assets-builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY resources/ ./resources/
COPY public/ ./public/
COPY vite.config.js postcss.config.js tailwind.config.js ./
ENV NODE_ENV=production
RUN npm run build

FROM php:8.2-fpm

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        unzip \
        libcurl4-openssl-dev \
        libpng-dev \
        libonig-dev \
        libxml2-dev \
        libssl-dev \
        autoconf \
        build-essential \
    && docker-php-ext-install curl dom simplexml mbstring exif pcntl bcmath gd \
    && pecl install mongodb \
    && docker-php-ext-enable mongodb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

COPY . .
COPY --from=laravel-assets-builder /app/public/build ./public/build
COPY --from=frontend-builder /app/build ./public/games

COPY docker/nginx/vercel.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/start-vercel.sh /usr/local/bin/start-nginx-after-php
COPY docker/php/production.ini /usr/local/etc/php/conf.d/production.ini
COPY docker/supervisor/vercel.conf /etc/supervisor/conf.d/supervisord.conf
RUN rm -f /etc/nginx/sites-enabled/default \
    && chmod +x /usr/local/bin/start-nginx-after-php \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache \
    && php artisan package:discover --ansi

EXPOSE 80

CMD ["/bin/sh", "-c", "sed -i \"s/listen 80;/listen ${PORT:-80};/\" /etc/nginx/conf.d/default.conf && exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf"]
